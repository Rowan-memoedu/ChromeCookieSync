{
  "manifest_version": 3,
  "name": "Chrome Cookie 本地同步",
  "version": "1.1.0",
  "key": "",
  "description": "手动导出本地 Cookie；启用后将当前 Chrome 登录态持续同步给本机渐进阅读导入服务。",
  "minimum_chrome_version": "119",
  "incognito": "not_allowed",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "同步全部 Chrome Cookie 到本地"
  }
}
